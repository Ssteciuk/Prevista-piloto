---
import arrowDown from '@phosphor-icons/core/assets/light/arrow-down-light.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/light/arrow-up-right-light.svg?raw';
import bicycle from '@phosphor-icons/core/assets/light/bicycle-light.svg?raw';
import check from '@phosphor-icons/core/assets/light/check-light.svg?raw';
import circleDashed from '@phosphor-icons/core/assets/light/circle-dashed-light.svg?raw';
import compass from '@phosphor-icons/core/assets/light/compass-light.svg?raw';
import cookingPot from '@phosphor-icons/core/assets/light/cooking-pot-light.svg?raw';
import envelope from '@phosphor-icons/core/assets/light/envelope-simple-light.svg?raw';
import frameCorners from '@phosphor-icons/core/assets/light/frame-corners-light.svg?raw';
import hardHat from '@phosphor-icons/core/assets/light/hard-hat-light.svg?raw';
import mapPin from '@phosphor-icons/core/assets/light/map-pin-light.svg?raw';
import phone from '@phosphor-icons/core/assets/light/phone-light.svg?raw';
import plus from '@phosphor-icons/core/assets/light/plus-light.svg?raw';
import ruler from '@phosphor-icons/core/assets/light/ruler-light.svg?raw';
import stack from '@phosphor-icons/core/assets/light/stack-light.svg?raw';
import sun from '@phosphor-icons/core/assets/light/sun-light.svg?raw';
import thermometer from '@phosphor-icons/core/assets/light/thermometer-light.svg?raw';
import whatsapp from '@phosphor-icons/core/assets/light/whatsapp-logo-light.svg?raw';

const icons = {
  arrowDown, arrowUpRight, bicycle, check, circleDashed, compass, cookingPot, envelope, frameCorners,
  hardHat, mapPin, phone, plus, ruler, stack, sun, thermometer, whatsapp,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg aria-hidden="true" focusable="false" class="${className}" `);
---

<Fragment set:html={svg} />
