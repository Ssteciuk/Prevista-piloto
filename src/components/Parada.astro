---
import { recorrido } from '../data/proyecto';

// Una parada del recorrido. El artículo marca la distancia de scroll del tramo; el texto se queda abajo a la
// izquierda mientras la cámara avanza y se va cuando llega la parada siguiente.
interface Props {
  index: number;
}

const { index } = Astro.props;
const parada = recorrido.paradas[index];
const pad = (n: number) => String(n).padStart(2, '0');
---

<article
  id={parada.id}
  data-parada
  data-focus={parada.focus}
  class="parada pointer-events-none flex min-h-[200svh] flex-col justify-end"
>
  <div class="parada-cuerpo pointer-events-auto sticky bottom-0 flex w-full max-w-2xl flex-col items-start px-4 pt-32 pb-12 md:px-12 lg:pb-16 xl:px-20">
    <p class="flex items-center gap-2 text-xs tracking-widest text-hueso/60 uppercase">
      <span class="tabular-nums">{pad(index + 1)} / {pad(recorrido.paradas.length)}</span>
      <span aria-hidden="true" class="size-1 rounded-full bg-arena"></span>
      <span>{parada.lugar}</span>
    </p>
    <slot />
  </div>
</article>

<style>
  :global(.js) .parada-cuerpo > :global(*) {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  :global(.js) .parada.is-current .parada-cuerpo > :global(*),
  :global(.js) .parada-cuerpo:focus-within > :global(*) {
    opacity: 1;
    transform: none;
    transition-duration: 1000ms;
  }

  .parada.is-current .parada-cuerpo > :global(:nth-child(2)) { transition-delay: 60ms; }
  .parada.is-current .parada-cuerpo > :global(:nth-child(3)) { transition-delay: 120ms; }
  .parada.is-current .parada-cuerpo > :global(:nth-child(4)) { transition-delay: 180ms; }
  .parada.is-current .parada-cuerpo > :global(:nth-child(5)) { transition-delay: 240ms; }
  .parada.is-current .parada-cuerpo > :global(:nth-child(6)) { transition-delay: 300ms; }

  :global(.js) .parada:not(.is-current) .parada-cuerpo:not(:focus-within) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .parada-cuerpo > :global(*) {
      transform: none;
    }
  }
</style>
