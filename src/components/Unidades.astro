---
import Icon from './Icon.astro';
import { contacto, proyecto, unidades } from '../data/proyecto';

const m2 = (n: number) => n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const consulta = (tipo: string) =>
  `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(`Hola, quiero plano y precio del ${tipo} de ${proyecto.nombre}.`)}`;
---

<section id="unidades" class="scroll-mt-24 px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="max-w-[680px]">
      <p class="eyebrow">Unidades</p>
      <h2 class="mt-4 text-4xl lg:text-5xl">Tres tipologías, todas con balcón</h2>
      <p class="mt-4 text-base text-hueso/70 lg:text-lg">Quedan {unidades.reduce((n, u) => n + u.disponibles, 0)} unidades disponibles. Pedí el plano de la que te interese y te mandamos precio y forma de pago.</p>
    </div>

    <ul class="mt-12 grid gap-4 md:grid-cols-3">
      {
        unidades.map((u) => (
          <li data-reveal class:list={['flex flex-col rounded-3xl p-6 ring-1', u.destacada ? 'bg-panel ring-arena/60' : 'bg-panel/60 ring-hueso/10']}>
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-2xl">{u.tipo}</h3>
              {u.destacada && <span class="rounded-full bg-arena px-3 py-1 text-xs font-semibold text-bg">La del recorrido</span>}
            </div>
            <dl class="mt-6 grid grid-cols-2 gap-4">
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-xs text-hueso/60">Cubiertos</dt>
                <dd class="text-2xl font-semibold tabular-nums">{m2(u.cubiertos)} m²</dd>
              </div>
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-xs text-hueso/60">Balcón</dt>
                <dd class="text-2xl font-semibold tabular-nums">{m2(u.balcon)} m²</dd>
              </div>
            </dl>
            <p class="mt-4 flex items-center gap-2 text-sm text-hueso/70"><Icon name="compass" class="size-4 text-arena" /> {u.orientacion}</p>
            <p class="mt-4 text-sm text-hueso/70">{u.detalle}</p>
            <p class="mt-6 text-xs text-hueso/60">{u.disponibles} disponibles</p>
            <a href={consulta(u.tipo)} target="_blank" rel="noopener" class:list={['btn mt-4', u.destacada ? 'btn-primary' : 'btn-ghost']}>
              <Icon name="whatsapp" class="size-5" /> Pedir plano y precio
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
