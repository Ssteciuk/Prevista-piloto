---
import Icon from './Icon.astro';
import Parada from './Parada.astro';
import { contacto, proyecto, recorrido } from '../data/proyecto';

const { paradas } = recorrido;
const titulo = 'mt-4 max-w-xl text-4xl lg:text-5xl';
const cuerpo = 'mt-4 max-w-md text-base text-hueso/80 lg:text-lg';
const pill = 'rounded-full bg-bg/40 px-3 py-1 ring-1 ring-hueso/20 backdrop-blur-md';
const whatsapp = `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(`Hola, quiero info de la ${recorrido.unidad} de ${proyecto.nombre}.`)}`;
---

<section id="recorrido" data-recorrido aria-label={`Recorrido por la ${recorrido.unidad}`} class="relative">
  <!-- Escenario fijo: los tramos de vídeo ocupan toda la pantalla. Debajo está el primer fotograma de cada tramo
       (mismo encuadre) para que el vídeo entre sin que se note y para que haya imagen mientras carga. -->
  <div data-escenario class="sticky top-0 h-lvh overflow-hidden bg-bg" style="--focus-x: 50%">
    <div aria-hidden="true" class="absolute inset-0">
      {
        paradas.map((parada, i) => (
          <img
            data-poster
            src={parada.poster}
            alt=""
            width="1920"
            height="1080"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
            class="poster absolute inset-0 size-full object-cover"
            style={i === 0 ? undefined : 'opacity: 0'}
          />
        ))
      }
      <div class="tramos absolute inset-0">
        {
          paradas.map((parada) => (
            <video
              data-tramo
              data-src={parada.clip}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              class="tramo absolute inset-0 size-full object-cover"
            />
          ))
        }
      </div>
    </div>

    <!-- Velos para que el texto se lea encima del vídeo. -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-bg/60 to-transparent"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-bg from-10% via-bg/50 via-45% to-transparent to-75% lg:bg-linear-to-r lg:from-bg/85 lg:via-bg/35 lg:via-35% lg:to-transparent lg:to-65%"
    >
    </div>

    <!-- Riel de paradas: dice dónde estás y deja saltar a cualquier ambiente. -->
    <nav aria-label="Ambientes del recorrido" class="absolute top-1/2 right-6 hidden -translate-y-1/2 lg:block xl:right-8">
      <ol class="relative flex flex-col items-end gap-4">
        <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-hueso/20">
          <span data-riel class="absolute inset-0 origin-top scale-y-0 bg-arena"></span>
        </span>
        {
          paradas.map((parada, i) => (
            <li>
              <a href={`#${parada.id}`} data-ir aria-current={i === 0 ? 'true' : 'false'} class="riel-link flex h-6 items-center gap-3">
                <span class="riel-label rounded-full bg-bg/60 px-3 py-1 text-xs whitespace-nowrap ring-1 ring-hueso/10 backdrop-blur-xl">
                  {parada.lugar}
                </span>
                <span class="riel-punto size-2 rounded-full bg-hueso/50" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p data-pista aria-hidden="true" class="absolute right-8 bottom-8 hidden items-center gap-3 text-xs tracking-widest text-hueso/70 uppercase lg:flex">
      Bajá para recorrer la unidad
      <span class="pista-linea relative block h-8 w-px overflow-hidden bg-hueso/20"></span>
    </p>
  </div>

  <!-- Paradas: el texto de cada ambiente. Editá el copy acá; los datos salen de src/data/proyecto.ts. -->
  <div class="relative z-10 -mt-[100lvh]">
    <Parada index={0}>
      <h1 class="mt-4">
        <span class="eyebrow block">{proyecto.nombre} · {proyecto.barrio}, {proyecto.ciudad}</span>
        <span class="titulo-hero mt-4 block max-w-[680px] pb-2 text-4xl lg:text-6xl">
          Recorré tu departamento<br /> antes de que esté terminado
        </span>
      </h1>
      <p class="mt-4 max-w-[680px] text-base text-hueso/80 lg:text-lg">
        Unidades de 2 a 4 ambientes en pozo, con balcón y amenities. Bajá y caminá la {recorrido.unidad.toLowerCase()} ambiente por ambiente.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href="#contacto" class="btn btn-primary">Agendar visita al showroom</a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-2 text-xs text-hueso/80" aria-label="Datos de la obra">
        <li class={pill}>Entrega {proyecto.entrega.toLowerCase()}</li>
        <li class={pill}>Obra al {proyecto.avance} %</li>
        <li class={pill}>{proyecto.unidades} unidades en {proyecto.pisos} pisos</li>
      </ul>
    </Parada>

    <Parada index={1}>
      <p class="eyebrow mt-4">Cocina integrada</p>
      <h2 class={titulo}>Una isla de 2,2 m para cocinar mirando al living</h2>
      <p class={cuerpo}>Mesada de cuarzo, anafe de inducción y alacenas hasta el techo. La cocina se abre al living sin perder guardado.</p>
      <dl class="mt-6 grid w-full max-w-md grid-cols-2 gap-4">
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-hueso/60">Metros lineales de mesada</dt>
          <dd class="text-3xl font-semibold">5,8 m</dd>
        </div>
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-hueso/60">Altura libre</dt>
          <dd class="text-3xl font-semibold">2,70 m</dd>
        </div>
      </dl>
    </Parada>

    <Parada index={2}>
      <p class="eyebrow mt-4">Living comedor</p>
      <h2 class={titulo}>31,4 m² con ventanal de piso a techo al norte</h2>
      <p class={cuerpo}>Sol de la mañana a la tarde y carpintería con doble vidriado hermético. El comedor entra completo para seis.</p>
      <ul class="mt-6 grid w-full max-w-md grid-cols-2 gap-4">
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-hueso/15 backdrop-blur-md">
          <Icon name="sun" class="size-6 text-arena" />
          <span class="text-sm text-hueso/80">Orientación norte, frente</span>
        </li>
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-hueso/15 backdrop-blur-md">
          <Icon name="frameCorners" class="size-6 text-arena" />
          <span class="text-sm text-hueso/80">Ventanal de 8 m corridos</span>
        </li>
      </ul>
    </Parada>

    <Parada index={3}>
      <p class="eyebrow mt-4">Dormitorio en suite</p>
      <h2 class={titulo}>Separado del living por el baño y el vestidor</h2>
      <p class={cuerpo}>El dormitorio principal tiene baño propio, placard de 2,4 m y salida directa al balcón. Ningún ruido del living llega a la cama.</p>
    </Parada>

    <Parada index={4}>
      <p class="eyebrow mt-4">Balcón corrido</p>
      <h2 class={titulo}>9,8 m² de balcón a lo largo de todo el frente</h2>
      <p class={cuerpo}>Se sale desde el living y desde el dormitorio. Desde el piso 9 la vista pasa por encima de las terrazas del barrio.</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href="#contacto" class="btn btn-primary">Agendar visita al showroom</a>
        <a href={whatsapp} class="btn btn-ghost" target="_blank" rel="noopener">
          <Icon name="whatsapp" class="size-5" /> Pedir plano y precio
        </a>
      </div>
    </Parada>
  </div>
</section>

<style>
  .poster {
    object-position: var(--focus-x) 50%;
    will-change: opacity, transform;
  }

  .tramos {
    opacity: 0;
    transition: opacity 1200ms var(--ease-fluid);
  }

  [data-modo='video'] .tramos {
    opacity: 1;
  }

  /* Solo se ve el tramo actual; el cambio entre tramos es instantáneo porque comparten fotograma. */
  .tramo {
    object-position: var(--focus-x) 50%;
    visibility: hidden;
  }

  .tramo.is-shown {
    visibility: visible;
  }

  .riel-label {
    opacity: 0;
    transform: translateX(0.5rem);
    transition: opacity 700ms var(--ease-fluid), transform 700ms var(--ease-fluid);
  }

  .riel-punto {
    transition: background-color 700ms var(--ease-fluid), transform 700ms var(--ease-fluid);
  }

  .riel-link:hover .riel-label,
  .riel-link:focus-visible .riel-label,
  .riel-link[aria-current='true'] .riel-label {
    opacity: 1;
    transform: none;
  }

  .riel-link:hover .riel-punto {
    background-color: var(--color-hueso);
  }

  .riel-link[aria-current='true'] .riel-punto {
    background-color: var(--color-arena);
    transform: scale(1.5);
  }

  .pista-linea::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-hueso);
    animation: pista 2400ms var(--ease-fluid) infinite;
  }

  @keyframes pista {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pista-linea::after {
      animation: none;
    }
  }
</style>
